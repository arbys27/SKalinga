DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_USER=postgres.<PROJECT_REF>
DB_PASSWORD=REPLACE_WITH_SUPABASE_SESSION_POOLER_PASSWORD
SITE_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_KEY
APP_ENV=development
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=REPLACE_WITH_CLOUDFLARE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_CLOUDFLARE_SECRET_KEY
TURNSTILE_FAIL_OPEN=false

MAIL_DRIVER=emailjs
LOGIN_OTP_MODE=email
EMAILJS_ORIGIN=http://localhost
EMAILJS_MONTHLY_LIMIT=200
EMAILJS_SERVICE_ID=REPLACE_WITH_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=REPLACE_WITH_EMAILJS_LOGIN_OTP_TEMPLATE_ID
EMAILJS_RESET_TEMPLATE_ID=REPLACE_WITH_EMAILJS_PASSWORD_RESET_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=REPLACE_WITH_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=REPLACE_WITH_EMAILJS_PRIVATE_KEY

SMS_DRIVER=unisms

UNISMS_API_KEY=
UNISMS_SENDER_ID=
